# ───────── تلگرام ─────────
# توکن ربات (از @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# آیدی کانال (مثلاً @mychannel یا -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel

# آیدی عددی ادمین (از @userinfobot)
TELEGRAM_ADMIN_ID=123456789

# (اختیاری) آدرس بنر منوی /start — پیش‌فرض: assets/banner.jpg داخل مخزن
START_BANNER_URL=

# ───────── Gemini ─────────
# کلید Gemini (از https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# مدل پیشنهادی (اگه منقضی بشه، خودکار مدل موجود پیدا می‌شه)
GEMINI_MODEL=gemini-2.0-flash

# ───────── بودجه Gemini (جلوگیری از بن شدن) ─────────
# حداقل فاصله بین دو درخواست (دقیقه)
GEMINI_MIN_INTERVAL_MIN=55
# حداکثر درخواست در روز
GEMINI_MAX_CALLS_PER_DAY=24
# حداکثر خبر در هر درخواست (بقیه ترجمه ساده می‌شن)
GEMINI_BATCH_SIZE=10

# ───────── پست آموزشی هوش مصنوعی (فقط متن) ─────────
# روشن/خاموش کردن پست آموزشی خودکار
EDU_POST_ENABLED=true
# فاصلهٔ طولانی بین دو پست (ساعت) — برای کم‌کردن مصرف توکن و پردازش GitHub
EDU_EVERY_HOURS=24
# حداکثر تلاش در هر اسلات بعد از شکست
EDU_MAX_TRIES_PER_SLOT=2
# چند عنوان اخیر در پرامپت فرستاده شود (کاهش توکن)
EDU_RECENT_PROMPT=6
# سقف توکن خروجی مدل (JSON کوتاه)
EDU_MAX_OUTPUT_TOKENS=800

# ───────── OpenRouter (فقط مدل رایگان، fallback بعد از Gemini) ─────────
# کلید از https://openrouter.ai/keys — اگر خالی باشد فقط Gemini استفاده می‌شود
OPENROUTER_API_KEY=
# اختیاری: فهرست دستی مدل‌ها با کاما. خالی = کشف خودکار مدل‌های :free
OPENROUTER_MODELS=
# حداکثر چند مدل رایگان در هر تلاش امتحان شود
OPENROUTER_MAX_MODELS=3
# سرصفحه‌های معرفی (اختیاری)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# ───────── رفتار ─────────
# سقف پست در هر راند اجرا (هر اجرا مثلاً هر ساعت تا این تعداد پست می‌رود)
MAX_POSTS_PER_RUN=15
# سقف امنیتی روزانه (اختیاری) — 0 یعنی خاموش
MAX_POSTS_PER_DAY=0
COLLECT_INTERVAL_MIN=45
# سقف پردازش در هر اجرا (جلوگیری از تایم‌اوت و اسپم تلگرام)
MAX_ARTICLES_PER_RUN=30
# حداکثر پیام «در انتظار تایید» که در هر اجرا به ادمین می‌رود
MAX_REVIEWS_PER_RUN=5
