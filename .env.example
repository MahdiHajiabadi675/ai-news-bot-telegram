# ───────── تلگرام ─────────
# توکن ربات (از @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# آیدی کانال (مثلاً @mychannel یا -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel

# آیدی عددی ادمین (از @userinfobot)
TELEGRAM_ADMIN_ID=123456789

# ───────── Gemini ─────────
# کلید Gemini (از https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# مدل پیشنهادی (اگه منقضی بشه، خودکار مدل موجود پیدا می‌شه)
GEMINI_MODEL=gemini-2.0-flash

# ───────── بودجه Gemini (جلوگیری از بن شدن) ─────────
# حداقل فاصله بین دو درخواست (دقیقه)
GEMINI_MIN_INTERVAL_MIN=55
# حداکثر درخواست در روز
GEMINI_MAX_CALLS_PER_DAY=24
# حداکثر خبر در هر درخواست (بقیه ترجمه ساده می‌شن)
GEMINI_BATCH_SIZE=10

# ───────── رفتار ─────────
MAX_POSTS_PER_DAY=15
COLLECT_INTERVAL_MIN=45
# سقف پردازش در هر اجرا (جلوگیری از تایم‌اوت و اسپم تلگرام)
MAX_ARTICLES_PER_RUN=30
# حداکثر پیام «در انتظار تایید» که در هر اجرا به ادمین می‌رود
MAX_REVIEWS_PER_RUN=5
