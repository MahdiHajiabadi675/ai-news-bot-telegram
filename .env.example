# ───────── تلگرام ─────────
# توکن ربات (از @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# آیدی کانال (مثلاً @mychannel یا -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel

# آیدی عددی ادمین (از @userinfobot)
TELEGRAM_ADMIN_ID=123456789

# (اختیاری) آدرس بنر منوی /start — پیش‌فرض: assets/banner.jpg داخل مخزن
START_BANNER_URL=

# (اختیاری) امضای کوتاه انتهای هر پست — متن ساده، مثل @your_channel
CHANNEL_SIGNATURE=

# (اختیاری، فقط Worker) لینک گروه بحث که در پست خوش‌آمد می‌آید
CHANNEL_GROUP_URL=

# ───────── Cloudflare KV (لازم برای GitHub Actions) ─────────
# از Cloudflare Dashboard → Workers & Pages → KV
CF_ACCOUNT_ID=
CF_KV_NAMESPACE=
# توکن API با دسترسی Workers KV Storage → Edit
CF_API_TOKEN=

# ───────── آینهٔ کانال بله (اختیاری) ─────────
BALE_BOT_TOKEN=
BALE_CHANNEL_ID=

# ───────── Secretهای Worker (در Cloudflare، نه GitHub) ─────────
# اجباری: بدون این، Worker فقط رنج IP تلگرام را قبول می‌کند
WEBHOOK_SECRET=
# برای محافظت از /run (اگر خالی باشد، /run کاملاً بسته است)
WORKER_SECRET=

# ───────── سیگنال Hacker News ─────────
# امتیاز/نظر HN روی خبر و جذابیت اثر می‌گذارد (API رایگان)
HN_ENABLED=true
HN_MAX_ITEMS=5

# ───────── مقالهٔ روز arXiv ─────────
# یک مقالهٔ تازهٔ cs.AI در روز، از این ساعت (به وقت ایران) به بعد
ARXIV_ENABLED=true
ARXIV_HOUR=13

# ───────── بازخورد بازدید (رایگان) ─────────
# بازدید از پیش‌نمایش عمومی کانال خوانده می‌شود؛ برای کانال با آیدی عددی، هندل عمومی را بده
VIEWS_ENABLED=true
CHANNEL_HANDLE=@your_channel
VIEWS_MIN_INTERVAL_MIN=30
VIEWS_PAGES=2
VIEWS_BOOST_MAX=8

# ───────── واکنش‌های تلگرام (دقیق‌تر از بازدید) ─────────
# Worker تجمیع واکنش‌ها را در KV ذخیره می‌کند؛ در /top و بوست دسته‌ها استفاده می‌شود.
REACTIONS_ENABLED=true
# هر واکنش معادل چند بازدید در محاسبهٔ محبوبیت
REACTIONS_WEIGHT=10
REACTIONS_BOOST_MAX=6

# ───────── بهداشت انتشار ─────────
# ساعت‌های سکوت به وقت ایران (خالی = خاموش). مثال: 0-7 یا 23-7
QUIET_HOURS=0-7
# حداقل فاصله بین دو راند انتشار (دقیقه)؛ 0 = خاموش
PUBLISH_MIN_GAP_MIN=20
# دکمهٔ «فرستادن به دوست» زیر پست‌ها
SHARE_BUTTON_ENABLED=true

# ───────── صبحانهٔ AI (خلاصهٔ صبح، رایگان) ─────────
BRIEF_ENABLED=true
BRIEF_HOUR=8
BRIEF_ITEMS=5
# ارسال همان خلاصه به مشترکان چت خصوصی (/subscribe)
DM_DIGEST_ENABLED=true
DM_DIGEST_MAX=200

# ───────── جمع‌بندی و نظرسنجی هفتگی ─────────
WEEKLY_ENABLED=true
# دوشنبه=0 ... شنبه=5 یکشنبه=6 — به وقت ایران
WEEKLY_DAY=5
WEEKLY_HOUR=21
WEEKLY_ITEMS=3
POLL_CLOSE_HOURS=48
POLL_MIN_VOTES=3
# بوست دستهٔ برندهٔ نظرسنجی در امتیازدهی
POLL_BOOST=6
POLL_BOOST_DAYS=7

# ───────── پیش‌زمینهٔ موضوعی (تایم‌لاین) ─────────
# لینک پست‌های قبلی همان شرکت/مدل زیر خبر جدید
STORYLINES_ENABLED=true
STORY_WINDOW_DAYS=45
STORY_LINKS_MAX=2

# ───────── تلاش مجدد ترجمه ─────────
# اگر ترجمه شکست بخورد، خبر یک راند در صف می‌ماند و دوباره تلاش می‌شود
TRANSLATE_RETRY_MAX=2

# ───────── پشتیبان‌گیری KV ─────────
BACKUP_ENABLED=true
# یکشنبه=6 — ساعت به وقت ایران
BACKUP_DAY=6
BACKUP_HOUR=3

# ───────── خبرنگار مردمی (/tip) ─────────
TIPS_ENABLED=true
# حداکثر سوژهٔ هر کاربر در ساعت
TIPS_MAX_PER_HOUR=1

# ───────── «چرا مهم است» زیر هر خبر (بدون مدل) ─────────
SHOW_WHY_IT_MATTERS=true

# ───────── آینهٔ Bluesky (اختیاری) ─────────
# App Password از Settings → Privacy and Security
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ───────── Gemini ─────────
# کلید Gemini (از https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# مدل پیشنهادی (اگه منقضی بشه، خودکار مدل موجود پیدا می‌شه)
GEMINI_MODEL=gemini-2.0-flash

# ───────── بودجه Gemini (جلوگیری از بن شدن) ─────────
# حداقل فاصله بین دو درخواست (دقیقه)
GEMINI_MIN_INTERVAL_MIN=55
# حداکثر درخواست در روز
GEMINI_MAX_CALLS_PER_DAY=24
# حداکثر خبر در هر درخواست (بقیه ترجمه ساده می‌شن)
GEMINI_BATCH_SIZE=10

# ───────── پست آموزشی هوش مصنوعی (فقط متن) ─────────
# روشن/خاموش کردن پست آموزشی خودکار
EDU_POST_ENABLED=true
# فاصلهٔ طولانی بین دو پست (ساعت) — برای کم‌کردن مصرف توکن و پردازش GitHub
EDU_EVERY_HOURS=6
# کنترل مصرف توکن: حداکثر خروجی «ردشده» در هر تلاش
EDU_MAX_REJECTS=2
# حداکثر تلاش ساخت در هر اسلات ۶ ساعته
EDU_MAX_TRIES_PER_SLOT=6
# حداقل فاصلهٔ تلاش‌ها (دقیقه) — تلاش‌ها در چند اجرای ساعتی پخش شوند
EDU_RETRY_GAP_MIN=56
# هدف پست آموزشی در هر روز (شب): انتشار تا رسیدن به این عدد جبران می‌شود
EDU_POSTS_PER_DAY=4
# حداکثر پست جبرانی در یک اجرا (اگر اجراهای قبلی عقب افتاده باشند)
EDU_CATCHUP_MAX=2
# اگر مدل‌ها خطا دادند، از ۱۲ پست آمادهٔ محلی استفاده شود (تور نجات)
EDU_BUILTIN_FALLBACK=true
# چند کوییز در هر شب (۰ = خاموش)؛ جدا از ۴ پست متنی، پیش‌فرض ۲ (اول و آخر بازه)
EDU_QUIZ_PER_DAY=2
# حداکثر پست در صف انتشار
EDU_QUEUE_MAX=8
# چند عنوان اخیر در پرامپت فرستاده شود (کاهش توکن)
EDU_RECENT_PROMPT=6
# سقف توکن خروجی مدل (JSON کوتاه)
EDU_MAX_OUTPUT_TOKENS=800

# ───────── OpenRouter (فقط مدل رایگان، fallback بعد از Gemini) ─────────
# کلید از https://openrouter.ai/keys — اگر خالی باشد فقط Gemini استفاده می‌شود
OPENROUTER_API_KEY=
# اختیاری: فهرست دستی مدل‌ها با کاما. خالی = کشف خودکار مدل‌های :free
OPENROUTER_MODELS=
# حداکثر چند مدل رایگان در هر تلاش امتحان شود
OPENROUTER_MAX_MODELS=3
# سرصفحه‌های معرفی (اختیاری)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# ───────── رفتار ─────────
# سقف پست در هر راند اجرا (هر اجرا مثلاً هر ساعت تا این تعداد پست می‌رود)
MAX_POSTS_PER_RUN=15
# سقف امنیتی روزانه (اختیاری) — 0 یعنی خاموش
MAX_POSTS_PER_DAY=0
COLLECT_INTERVAL_MIN=45
# سقف پردازش در هر اجرا (جلوگیری از تایم‌اوت و اسپم تلگرام)
MAX_ARTICLES_PER_RUN=30
# حداکثر پیام «در انتظار تایید» که در هر اجرا به ادمین می‌رود
MAX_REVIEWS_PER_RUN=5
